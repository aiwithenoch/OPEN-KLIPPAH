# Open Klippah MCP server configuration
#
# Copy to .env (or set these in your MCP client config) and fill in values.

# --- Authentication (required for everything except the public discovery tools) ---
# Create a key in your Open Klippah account: Settings -> API Keys. Starts with "sk_".
OPEN_KLIPPAH_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend selection ---
# Defaults to the official hosted instance. Override for self-hosting.
# OPEN_KLIPPAH_API_URL=https://api.openklippah.com
# OPEN_KLIPPAH_API_URL=http://localhost:8000

# --- Where downloaded/exported clips are written ---
# Defaults to ./openklippah-downloads (relative to the server's working directory).
# OPEN_KLIPPAH_DOWNLOAD_DIR=/absolute/path/to/clips

# --- HTTP timeout for non-download requests, in seconds (default 60) ---
# OPEN_KLIPPAH_TIMEOUT=60

# --- Hosted MCP server mode ---
# Local MCP clients usually use stdio. For a hosted endpoint, run SSE:
# OPEN_KLIPPAH_MCP_TRANSPORT=sse
# OPEN_KLIPPAH_MCP_HOST=0.0.0.0
# OPEN_KLIPPAH_MCP_PORT=9100
# OPEN_KLIPPAH_MCP_PUBLIC_URL=https://mcp.openklippah.com
# OPEN_KLIPPAH_MCP_REQUIRE_BEARER_AUTH=true

# --- Self-hosting auth alternatives (only if you are NOT using an API key) ---
# For a self-hosted backend you can authenticate with a user id directly:
#   * If the backend enforces signing (BACKEND_AUTH_SECRET set), provide both:
# OPEN_KLIPPAH_USER_ID=your-user-id
# OPEN_KLIPPAH_AUTH_SECRET=the-backend-BACKEND_AUTH_SECRET
#   * If the backend runs with ALLOW_UNSIGNED_BACKEND_AUTH=true, the user id alone is enough:
# OPEN_KLIPPAH_USER_ID=your-user-id
